<?xml version="1.0"?>
<package format="3">
  <name>mi_dog_real</name>
  <version>0.1.0</version>
  <description>Safety-gated CyberDog 2 sensor and locomotion adapter for the mi_dog project.</description>
  <maintainer email="maintainer@example.invalid">mi_dog team</maintainer>
  <license>Apache-2.0</license>

  <buildtool_depend>ament_cmake</buildtool_depend>

  <depend>geometry_msgs</depend>
  <depend>lcm</depend>
  <depend>nav_msgs</depend>
  <depend>protocol</depend>
  <depend>rclcpp</depend>
  <depend>sensor_msgs</depend>
  <depend>std_msgs</depend>
  <exec_depend>launch</exec_depend>
  <exec_depend>launch_ros</exec_depend>
  <exec_depend>rclpy</exec_depend>

  <export>
    <build_type>ament_cmake</build_type>
  </export>
</package>
