[Unit]
Description=Mi Dog manual maintenance stack (fail-closed until operator START)
After=network.target

[Service]
Type=simple
User=mi
WorkingDirectory=/home/mi/mi_dog_ws
ExecStart=/home/mi/mi_dog_ws/scripts/run_sensor_gate.sh maintenance
Restart=on-failure
RestartSec=5
KillSignal=SIGINT
TimeoutStopSec=20

[Install]
WantedBy=multi-user.target
